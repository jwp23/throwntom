#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# bd records why each bead moved in the interaction log. That reasoning belongs in
# the same commit as the work it describes, so it is staged here rather than left
# to drift behind the code it explains.
#
# bd keeps one log for the whole repository, beside the Dolt database in the main
# working tree, so a commit made from a worktree has to reach across to it: the
# worktree's own checked-out copy never receives the entries bd just wrote.
interactions=.beads/interactions.jsonl
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
live="$(dirname "$common_dir")/$interactions"
if [ -f "$live" ]; then
  if [ ! "$live" -ef "$interactions" ]; then
    cp "$live" "$interactions"
  fi
  if ! git diff --quiet -- "$interactions"; then
    echo "pre-commit: staging $interactions"
    git add "$interactions"
  fi
fi

echo "pre-commit: checking gofmt"
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "The following files are not gofmt-formatted:"
  echo "$unformatted"
  echo "Run: gofmt -w <file>"
  exit 1
fi

if git diff --cached --quiet -- 'macos/Throwntom/*.swift'; then
  echo "pre-commit: no Swift changes staged, skipping swift-lint"
else
  echo "pre-commit: running swift-lint"
  macos/swift-lint.sh || {
    echo "Run: macos/swift-lint.sh --fix"
    exit 1
  }
fi

echo "pre-commit: running unit tests"
go test -timeout 30s ./...

echo "pre-commit: passed"
