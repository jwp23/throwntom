#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-commit: checking gofmt"
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "The following files are not gofmt-formatted:"
  echo "$unformatted"
  echo "Run: gofmt -w <file>"
  exit 1
fi

if git diff --cached --quiet -- 'macos/Throwntom/*.swift'; then
  echo "pre-commit: no Swift changes staged, skipping swift-lint"
else
  echo "pre-commit: running swift-lint"
  macos/swift-lint.sh || {
    echo "Run: macos/swift-lint.sh --fix"
    exit 1
  }
fi

echo "pre-commit: running unit tests"
go test -timeout 30s ./...

echo "pre-commit: passed"
